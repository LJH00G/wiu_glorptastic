  m_Script: {fileID: 11500000, guid: 34f2ff470233db34a958620f483cd295, type: 3}
  m_Name: cave_garden_piao_1_dial_data
  m_EditorClassIdentifier: Assembly-CSharp::Game.SO.Data.TextMarkup.Dialogue.DialogueConversationSO
  <Dialogues>k__BackingField:
  - speaker: {fileID: 11400000, guid: 820cb9029b4ac8443b18636ed7bd5bb4, type: 2}
    text: Hello, <wait time="0.5"/>what are you doing here?<input/><end/>
    endAction: {fileID: 0}
  - speaker: {fileID: 11400000, guid: e153e336f1116a845803d4dc545b9924, type: 2}
    text: Im enjoying the nature in this mini garden.<input/><end/>
    endAction: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 820cb9029b4ac8443b18636ed7bd5bb4, type: 2}
    text: Do you know there's a wall at the north of the cave, <wait time="0.5"/>that
      seems to have a path up there?<input/><end/>
    endAction: {fileID: 0}
  - speaker: {fileID: 11400000, guid: e153e336f1116a845803d4dc545b9924, type: 2}
    text: Yes, <wait time="0.5"/>I do.<input/><end/>
    endAction: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 820cb9029b4ac8443b18636ed7bd5bb4, type: 2}
    text: Can you help me get up there?<input/><end/>
    endAction: {fileID: 0}
  - speaker: {fileID: 11400000, guid: e153e336f1116a845803d4dc545b9924, type: 2}
    text: <interval time="0.25"/>Hummm<interval time="0.75"/>, <wait time="0.5"/>if
      you help me get a <color value="#88FFD9FF">Chill Grass</color>, <wait time="0.5"/>I
      will help you.<input/><end/>
    endAction: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 820cb9029b4ac8443b18636ed7bd5bb4, type: 2}
    text: Okay.<input/><end/>
    endAction: {fileID: 0}
