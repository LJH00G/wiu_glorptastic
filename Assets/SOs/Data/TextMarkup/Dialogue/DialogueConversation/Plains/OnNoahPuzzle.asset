  <Dialogues>k__BackingField:
  - speaker: {fileID: 11400000, guid: 7f46410b7dc996640a3ba4dba065afd4, type: 2}
    text: Wait! I recognise this machine.. <input/> <end/>
    endAction: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 7f46410b7dc996640a3ba4dba065afd4, type: 2}
    text: Its one of those generators, looks like this one was rigged up to the car
      <input/> <end/>
    endAction: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 7f46410b7dc996640a3ba4dba065afd4, type: 2}
    text: Its one of those generators, looks like this one was rigged up to the car
      <input/> <end/>
    endAction: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 7f46410b7dc996640a3ba4dba065afd4, type: 2}
