  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 34f2ff470233db34a958620f483cd295, type: 3}
  m_Name: ThankingDino
  m_EditorClassIdentifier: Assembly-CSharp::Game.SO.Data.TextMarkup.Dialogue.DialogueConversationSO
  <Dialogues>k__BackingField:
  - speaker: {fileID: 11400000, guid: f9c57879b036a7848b608257b20350d8, type: 2}
    text: Thank you for rescuing me, really was trapped in a pickle there! <input/>
      <end/>
    endAction: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 7f46410b7dc996640a3ba4dba065afd4, type: 2}
    text: Oh, Dino Mike! You were here? What are you doing, fighing some random bug?
    endAction: {fileID: 0}
  - speaker: {fileID: 11400000, guid: f9c57879b036a7848b608257b20350d8, type: 2}
    text: I was trying to fetch my own tools, but that darn bug took my dynamite
      <input/> <end/>
    endAction: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 7f46410b7dc996640a3ba4dba065afd4, type: 2}
    text: Say, what was that item you found over at the bug? <input/> <end/>
    endAction: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 820cb9029b4ac8443b18636ed7bd5bb4, type: 2}
    text: Oh, its this, weird glowing shard <input/> <end/>
    endAction: {fileID: 0}
  - speaker: {fileID: 11400000, guid: f9c57879b036a7848b608257b20350d8, type: 2}
    text: Holy, jeebers, ain't that one shiny gem aint it? Mighty green ain't it.
      <input/> <end/>
    endAction: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 7f46410b7dc996640a3ba4dba065afd4, type: 2}
    text: Wait, isn't this the gem that Emilia Aerhart wanted? She was building that
      machine to locate all other shards. We should give it to her. <input/> <end/>
    endAction: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 7f46410b7dc996640a3ba4dba065afd4, type: 2}
    text: 
    endAction: {fileID: 0}
